# CPS direct-debug runtime configuration.
# Docker uses deploy/docker/.env and container-internal ports instead.
# Copy this file to .env. Never commit real credentials.

CPS_ENVIRONMENT=development
CPS_SERVICE_NAME=cps
CPS_LOG_LEVEL=INFO
CPS_DATABASE_URL=postgresql+psycopg://cmp:cmp_dev_password@127.0.0.1:5432/cmp_cps_dev  # pragma: allowlist secret
CPS_RABBITMQ_URL=amqp://cmp:cmp_dev_password@127.0.0.1:5673/cmp  # pragma: allowlist secret
CPS_API_HOST=127.0.0.1
CPS_API_PORT=8000
CPS_KEYCLOAK_URL=http://127.0.0.1:8080
CPS_KEYCLOAK_REALM=vnpost
CPS_KEYCLOAK_CLIENT_ID=cmp
CPS_KEYCLOAK_ISSUER_OVERRIDE=http://keycloak:8080/realms/vnpost
CPS_CREDENTIAL_KEY_RING=v1:a2tra2tra2tra2tra2tra2tra2tra2tra2tra2tra2s=  # pragma: allowlist secret
